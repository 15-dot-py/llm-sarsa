page{background:#181d17;color:#ecece4;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}button{font-size:27rpx;font-weight:500;border-radius:8rpx;line-height:1.5;margin:0;padding:20rpx 24rpx;background:#d6b27b;color:#181d17}button::after{border:0}button[disabled]{background:#4a4d40!important;color:#a4aa9a!important}input,textarea{border:1px solid #414b3a;border-radius:8rpx;padding:20rpx 24rpx;background:#242b20;color:#ecece4;font-size:29rpx;width:100%}input{height:86rpx}textarea{min-height:170rpx}.page{padding:32rpx 34rpx 65rpx}.title{font-size:43rpx;font-weight:600;line-height:1.4}.section-title{font-size:32rpx;font-weight:600;margin:28rpx 0 18rpx}.muted{color:#a7b29b;font-size:24rpx}.fine{color:#9ba88f;font-size:23rpx;line-height:1.7;margin:16rpx 0}.error{color:#edb09b;font-size:26rpx;margin:20rpx 0}.label{color:#bfc8b4;font-size:25rpx;margin:23rpx 0 10rpx}.line{border-top:1px solid #394130;margin:30rpx 0}.secondary{color:#d6b27b;background:transparent;border:1px solid #50593f}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.notice{color:#d6b27b;font-size:25rpx;margin:20rpx 0}.account{color:#d6b27b;background:none;font-size:24rpx;padding:12rpx}.privacy-link{color:#d6b27b}.check{display:flex;align-items:center;color:#bbc5b0;font-size:24rpx;margin:20rpx 0}.check checkbox{transform:scale(.8);margin-left:-12rpx}
.brand-logo{display:block;width:280rpx;height:96rpx}
