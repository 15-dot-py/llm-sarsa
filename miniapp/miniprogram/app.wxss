page{min-height:100%;background:#08111f;color:#e8edf6;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.page{padding:28rpx;box-sizing:border-box}.card{background:#101b2c;border:1rpx solid #22314a;border-radius:22rpx;padding:28rpx;margin-bottom:22rpx;box-sizing:border-box}.eyebrow{color:#d8b46a;font-size:22rpx;letter-spacing:3rpx}.h1{font-size:46rpx;line-height:1.25;font-weight:700;margin:12rpx 0}.h2{font-size:30rpx;font-weight:650;margin-bottom:16rpx}.muted{color:#8f9ab0;font-size:24rpx;line-height:1.6}.value{font-size:38rpx;font-weight:700;margin-top:8rpx}.input,.textarea{width:100%;box-sizing:border-box;background:#0b1525;border:1rpx solid #2b3b57;color:#f4f6fa;border-radius:16rpx;padding:22rpx 24rpx;margin-top:14rpx}.textarea{min-height:190rpx}.primary{width:100%;border:0;border-radius:16rpx;background:#d8b46a;color:#111722;font-weight:700;margin-top:24rpx}.secondary{width:100%;border:1rpx solid #34435e;border-radius:16rpx;background:#111d30;color:#dbe3ef;margin-top:18rpx}.grid{display:flex;flex-wrap:wrap;justify-content:space-between}.metric{width:48%;margin-bottom:20rpx}.tag{display:inline-block;background:#15243a;color:#b9c7da;border:1rpx solid #2b3d5c;border-radius:999rpx;padding:8rpx 16rpx;font-size:22rpx}.error{color:#ff8f8f;margin-top:14rpx;font-size:24rpx}.success{color:#8bd6aa;margin-top:14rpx;font-size:24rpx}