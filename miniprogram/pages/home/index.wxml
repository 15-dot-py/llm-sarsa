<view class="page"><view class="row page-head"><image class="brand-logo" src="/assets/brand-logo.png" mode="aspectFill"/><button class="account" bindtap="account">{{user.phone_mask || '账号'}}</button></view>
<view wx:if="{{loading}}" class="muted">正在读取工作区…</view><view wx:if="{{error}}" class="error">{{error}}</view>
<block wx:if="{{dashboard}}"><view class="tabs"><view wx:for="{{tabs}}" wx:key="id" class="tab {{panel===item.id?'active':''}}" data-id="{{item.id}}" bindtap="panel">{{item.name}}</view></view>
<block wx:if="{{panel==='work'}}"><view class="title">营销工作台</view><view class="fine">{{dashboard.quality.label}} · {{dashboard.quality.days}} 天 · {{dashboard.quality.rows}} 行</view><view class="metrics"><view wx:for="{{metrics}}" wx:key="name"><view class="metric-name">{{item.name}}</view><view class="metric-value">{{item.value}}</view></view></view><view class="line"/>
<block wx:if="{{!record}}"><view class="section-title">制定决策</view><view class="label">经营问题</view><textarea value="{{question}}" bindinput="input" data-field="question" maxlength="1600" placeholder="填写本次经营问题"/>
<view class="label">经营目标</view><picker range="{{profiles}}" range-key="label" value="{{profileIndex}}" bindchange="profile"><view class="picker">{{profiles[profileIndex].label}}</view></picker>
<view class="label">每日预算 / 元</view><input type="digit" value="{{budget}}" data-field="budget" bindinput="input"/>
<view class="return" bindtap="toggleConstraints">{{showConstraints?'收起业务约束':'业务约束'}}</view><block wx:if="{{showConstraints}}"><view class="options"><view><view class="label">成交价底线 / 元</view><input type="digit" value="{{floor}}" data-field="floor" bindinput="input"/></view><view><view class="label">毛利底线 / 小数</view><input type="digit" value="{{margin}}" data-field="margin" bindinput="input"/></view></view><view class="row label"><text>禁止新增促销</text><switch checked="{{noPromo}}" bindchange="noPromo" color="#a98a58"/></view><checkbox-group bindchange="stopped"><view class="check" wx:for="{{['抖音','小红书','淘宝','搜索广告','私域']}}" wx:key="*this"><checkbox value="{{item}}" color="#d6b27b"/><text>停用{{item}}</text></view></checkbox-group></block>
<button class="primary-wide" bindtap="generate" loading="{{busy}}" disabled="{{busy}}">生成营销建议</button><view class="fine">库存和订单等实测指标以数据库为准。</view></block>
<block wx:else><view class="muted">{{record.statusLabel}}</view><view class="action-title">{{record.action_label}}</view><view class="explanation">{{record.explanation.summary}}</view><view wx:for="{{record.explanation.reasons}}" wx:key="*this" class="reason">{{item}}</view><view class="fine">动作：{{record.decision_source}} · 解释：{{record.explanation_source==='LLM'?'LLM':'模板'}} · 版本 {{record.model_version}}</view>
<view class="return" bindtap="toggleQ">{{showQ?'收起模型依据':'查看模型依据'}}</view><block wx:if="{{showQ}}"><view wx:for="{{record.qRows}}" wx:key="name" class="q-row"><view class="row"><text>{{item.label}}</text><text class="q-value">{{item.qLabel}}</text></view><view wx:if="{{!item.legal}}" class="fine">已屏蔽：{{item.reasons}}</view></view></block>
<block wx:if="{{record.id===activeId && record.status==='draft'}}"><view class="line"/><view class="section-title">确认实际执行</view><view wx:if="{{record.parent_decision}}" class="fine">上一轮结果已保存，确认下一实际动作后才完成 SARSA 更新。</view><picker range="{{record.legalActions}}" range-key="label" value="{{actionIndex}}" bindchange="action"><view class="picker">{{record.legalActions[actionIndex].label}}</view></picker><block wx:if="{{record.legalActions[actionIndex].name!==record.action_name}}"><view class="label">人工调整理由</view><input value="{{reason}}" bindinput="input" data-field="reason" maxlength="300"/></block><view class="buttons"><button bindtap="execute" disabled="{{busy}}">确认执行</button><button wx:if="{{!record.parent_decision}}" class="secondary" bindtap="cancel" disabled="{{busy}}">取消草稿</button><button wx:else class="secondary" bindtap="finish" disabled="{{busy}}">结束周期</button></view></block>
<block wx:if="{{record.id===activeId && record.status==='executed'}}"><view class="line"/><view class="section-title">记录实际经营结果</view><view class="fine">填写同一期经营结果。这里不将主观评价作为数值回报。</view><view class="feedback"><view class="label">收入 / 元</view><input type="digit" data-field="revenue" bindinput="feedbackInput"/><view class="label">营销贡献利润 / 元（可为负）</view><input type="text" data-field="profit" bindinput="feedbackInput"/><view class="label">营销 ROI（可为负）</view><input type="text" data-field="roi" bindinput="feedbackInput"/><view class="label">广告 CAC / 元</view><input type="digit" data-field="cac" bindinput="feedbackInput"/><view class="label">库存 / 件</view><input type="digit" data-field="inventory_level" bindinput="feedbackInput"/><view class="label">转化率 / 0 到 1 的小数</view><input type="digit" data-field="conversion_rate" bindinput="feedbackInput"/><view class="row label"><text>本周期已结束</text><switch checked="{{terminal}}" bindchange="terminal" color="#a98a58"/></view><button class="primary-wide" bindtap="feedback" disabled="{{busy}}">保存结果</button></view></block>
<view wx:if="{{record.actual_reward}}" class="notice">综合回报 {{record.rewardLabel}} · {{record.user_feedback.provenance.label}}</view><view wx:if="{{record.previous_update || record.transition.update}}" class="fine">更新凭证已保存，可在完整记录中核对。</view><button wx:if="{{!activeId}}" class="secondary primary-wide" bindtap="newDecision">新建决策</button></block></block>
<block wx:if="{{panel==='data'}}"><view class="title">运营数据库</view><view class="fine">{{dashboard.quality.label}}</view><view class="fine">{{dashboard.metrics.cost_method}}</view><view class="buttons"><button bindtap="upload" disabled="{{busy}}">上传 CSV</button><button class="secondary" bindtap="demo" disabled="{{busy}}">加载合成示例</button></view><scroll-view scroll-x><view class="table"><view class="table-row head"><text class="table-cell">渠道</text><text class="table-cell">收入 / 元</text><text class="table-cell">广告费 / 元</text><text class="table-cell">ROI</text><text class="table-cell">CAC / 元</text></view><view class="table-row" wx:for="{{channels}}" wx:key="channel"><text class="table-cell">{{item.channel}}</text><text class="table-cell">{{item.revenueText}}</text><text class="table-cell">{{item.costText}}</text><text class="table-cell">{{item.roiText}}</text><text class="table-cell">{{item.cacText}}</text></view></view></scroll-view><view class="fine">{{dashboard.quality.warnings}}</view><view class="fine">利润口径为营销贡献利润。合成示例不代表企业内部业绩。</view></block>
<block wx:if="{{panel==='history'}}"><view class="title">决策记录</view><view class="fine">只显示此账号工作区的记录。</view><view wx:if="{{!history.length}}" class="muted">还没有决策记录。</view><view wx:for="{{history}}" wx:key="id" class="record-row" data-id="{{item.id}}" bindtap="openRecord"><view class="record-title">{{item.action_label}}</view><view class="record-meta">{{item.statusLabel}} · {{item.timestamp}}</view><view class="fine">{{item.question}}</view></view></block>
<block wx:if="{{panel==='model'}}"><view class="title">模型与回报</view><view class="fine">Deep SARSA 选择动作，LLM 理解问题并解释已确定的动作。</view><view class="quote">状态 {{dashboard.state.state_dim}} 维 · {{dashboard.model_version}}</view><view class="quote">{{dashboard.llm.mode}}</view><view wx:if="{{lab}}" class="fine">网络 {{lab.network}} · 已更新 {{lab.updates}} 次</view><block wx:if="{{reward}}"><view class="section-title">收益与惩罚因子</view><view class="fine">{{reward.formula}}</view><view wx:for="{{reward.factors}}" wx:key="name" class="q-row"><view class="reward-title">{{item.label}} · {{item.sign===1?'收益加分':'成本扣分'}}</view><view>{{item.formula}}</view><view class="fine">{{item.note}}</view></view><view class="fine">{{reward.boundary}}</view></block></block>
</block></view>
